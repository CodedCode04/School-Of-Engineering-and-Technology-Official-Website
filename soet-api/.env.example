# Environment
NODE_ENV=development
PORT=5000

# Client URL (for CORS and redirects)
CLIENT_ORIGINS=http://localhost:5173,https://soet-client.pages.dev,https://soet.ac.in,https://www.soet.ac.in

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soet?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_key_here
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# R2 / S3 Cloud Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://assets.soet.ac.in
PRESIGN_EXPIRES_SECONDS=300

# Initial Admin (Legacy / Fallback)
ADMIN_EMAIL=admin@soet.ac.in
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
